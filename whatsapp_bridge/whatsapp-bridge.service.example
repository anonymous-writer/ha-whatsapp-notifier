[Unit]
Description=WhatsApp Bridge (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/whatsapp-bridge-linux --config %h/.config/whatsapp-bridge/config.yaml
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
