[Unit]
Description=WhatsApp Bridge (Go Native)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Pods/Home-Assistant/whatsapp-bridge
Environment=CONFIG_FILE=%h/.config/whatsapp-bridge/config.yaml
ExecStart=%h/.local/bin/whatsapp-bridge-linux
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
